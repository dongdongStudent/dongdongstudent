    "22": [
      {
        "text": "Sichuan opera is very famous in China. Look! This man is wearing many masks. He can change his masks to show different feelings. He can do that very fast. It's amazing!",
        "x": 15.49,
        "y": 23.1,
        "w": 67.97,
        "h": 20.32,
        "translator": "川剧在中国非常有名。看！这个人戴着很多面具。他可以变换面具来表达不同的情感。他动作非常快。太神奇了！"
      },
      {
        "text": "My mask is pink and white. It's smiling. I'm happy.",
        "x": 8.33,
        "y": 68.92,
        "w": 18.23,
        "h": 10.11,
        "translator": "我的面具是粉白相间的。它在微笑。我很开心。"
      },
      {
        "text": "My mask is blue. It's crying. I'm sad.",
        "x": 27.08,
        "y": 71.43,
        "w": 18.36,
        "h": 7.33,
        "translator": "我的面具是蓝色的。它在哭泣。我很伤心。"
      },
      {
        "text": "My mask is red and yellow. Look! I'm angry.",
        "x": 45.57,
        "y": 66.42,
        "w": 20.18,
        "h": 7.79,
        "translator": "我的面具是红黄相间的。看！我很生气。"
      },
      {
        "text": "My mask is orange and has a big open mouth. I'm very excited.",
        "x": 66.41,
        "y": 68.92,
        "w": 20.44,
        "h": 9.93,
        "translator": "我的面具是橙色的，张着大嘴。我非常兴奋。"
      }
