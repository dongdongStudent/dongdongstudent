[
  {
    "timestamp": "00:01:27,184 --> 00:01:28,096",
    "chinese": "喂？",
    "english": "Hello?"
  },
  {
    "timestamp": "00:01:28,272 --> 00:01:33,312",
    "chinese": "嘿，彬彬。我是彼得。你现在在做什么？",
    "english": "Hey, Binbin. It’s Peter. What are you doing right now?"
  },
  {
    "timestamp": "00:01:33,696 --> 00:01:39,024",
    "chinese": "没什么特别的事！我在看电影，但这电影很无聊。",
    "english": "Nothing much! I’m watching a film, but it’s quite boring."
  },
  {
    "timestamp": "00:01:39,200 --> 00:01:40,512",
    "chinese": "那太糟了。",
    "english": "That’s too bad."
  },
  {
    "timestamp": "00:01:40,960 --> 00:01:44,352",
    "chinese": "我正考虑去体育公园打排球。",
    "english": "I’m thinking about playing volleyball at the sports park."
  },
  {
    "timestamp": "00:01:44,784 --> 00:01:46,304",
    "chinese": "你想来吗？",
    "english": "Would you like to come?"
  },
  {
    "timestamp": "00:01:46,544 --> 00:01:47,744",
    "chinese": "当然想！",
    "english": "Of course!"
  },
  {
    "timestamp": "00:01:48,016 --> 00:01:51,680",
    "chinese": "我们十点在体育公园见，好吗？",
    "english": "Let’s meet at the sports park at ten, OK?"
  },
  {
    "timestamp": "00:01:51,984 --> 00:01:54,416",
    "chinese": "太棒了！到时候见！",
    "english": "Cool! See you then!"
  }
]