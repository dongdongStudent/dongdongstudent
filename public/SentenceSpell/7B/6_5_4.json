[
  {
    "timestamp": "00:01:46,448 --> 00:01:48,368",
    "chinese": "爬山真累人！",
    "english": "Climbing is tiring!"
  },
  {
    "timestamp": "00:01:48,768 --> 00:01:52,304",
    "chinese": "我的鞋也都又湿又脏。",
    "english": "My shoes are all wet and dirty too."
  },
  {
    "timestamp": "00:01:53,504 --> 00:01:57,200",
    "chinese": "这个休息区还有许多其他游客，",
    "english": "There are many other tourists at this rest area,"
  },
  {
    "timestamp": "00:01:57,376 --> 00:02:00,048",
    "chinese": "但他们似乎一点也不累。",
    "english": "but they don’t seem tired at all."
  },
  {
    "timestamp": "00:02:00,752 --> 00:02:03,952",
    "chinese": "相反，他们有说有笑！",
    "english": "Instead, they’re talking and laughing!"
  },
  {
    "timestamp": "00:02:05,056 --> 00:02:08,736",
    "chinese": "我姐姐海伦也兴致很高。",
    "english": "My sister Helen is also in high spirits."
  },
  {
    "timestamp": "00:02:16,176 --> 00:02:18,416",
    "chinese": "我们到光明顶了。",
    "english": "We’re here at Bright Peak."
  },
  {
    "timestamp": "00:02:19,008 --> 00:02:22,544",
    "chinese": "阳光下的黄山很美。",
    "english": "Mount Huangshan is beautiful in the sunlight."
  },
  {
    "timestamp": "00:02:23,552 --> 00:02:25,328",
    "chinese": "我又累又饿，",
    "english": "I’m tired and hungry,"
  },
  {
    "timestamp": "00:02:25,584 --> 00:02:28,704",
    "chinese": "但站在山顶的感觉真好！",
    "english": "but it feels good to be at the top!"
  }
]