[
  {
    "timestamp": "00:00:09,264 --> 00:00:11,136",
    "chinese": "你在做什么？",
    "english": "What are you doing?"
  },
  {
    "timestamp": "00:00:11,584 --> 00:00:13,312",
    "chinese": "我在遛狗。",
    "english": "I’m walking my dog."
  },
  {
    "timestamp": "00:00:13,568 --> 00:00:16,896",
    "chinese": "你想去体育公园和我一起踢足球吗？",
    "english": "Would you like to play football with me at the sports park?"
  },
  {
    "timestamp": "00:00:17,152 --> 00:00:21,152",
    "chinese": "是的，我很想去。我们什么时候见面？",
    "english": "Yes, I’d love to. When shall we meet?"
  },
  {
    "timestamp": "00:00:21,616 --> 00:00:23,696",
    "chinese": "我们三点钟见面吧。",
    "english": "Let’s meet at three o’clock."
  },
  {
    "timestamp": "00:00:23,808 --> 00:00:24,896",
    "chinese": "好的。",
    "english": "Sure."
  }
]