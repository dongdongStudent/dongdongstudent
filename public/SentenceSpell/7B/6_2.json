[
  {
    "timestamp": "00:00:11,696 --> 00:00:14,368",
    "chinese": "嘿，爷爷。您好吗？",
    "english": "Hey, Grandpa. How are you?"
  },
  {
    "timestamp": "00:00:14,720 --> 00:00:16,848",
    "chinese": "澳大利亚的天气怎么样？",
    "english": "How’s the weather in Australia?"
  },
  {
    "timestamp": "00:00:17,136 --> 00:00:21,344",
    "chinese": "嗨，露西。正在下倾盆大雨。",
    "english": "Hi, Lucy. It’s raining cats and dogs."
  },
  {
    "timestamp": "00:00:22,240 --> 00:00:25,296",
    "chinese": "哦！现在闪电了！",
    "english": "Oh! And now there’s lightning!"
  },
  {
    "timestamp": "00:00:25,488 --> 00:00:28,096",
    "chinese": "哦不，别出去！",
    "english": "Oh no, don’t go outside!"
  },
  {
    "timestamp": "00:00:28,800 --> 00:00:33,760",
    "chinese": "别担心。我待在家里呢！老家的天气怎么样？",
    "english": "Don’t worry. I’m staying in! What’s the weather like back home?"
  },
  {
    "timestamp": "00:00:34,528 --> 00:00:36,000",
    "chinese": "你现在在做什么？",
    "english": "What are you doing now?"
  },
  {
    "timestamp": "00:00:36,672 --> 00:00:38,992",
    "chinese": "我正在花园里浇花。",
    "english": "I’m watering flowers in the garden."
  },
  {
    "timestamp": "00:00:39,280 --> 00:00:41,376",
    "chinese": "这里阳光明媚，很暖和！",
    "english": "It’s sunny and warm here!"
  },
  {
    "timestamp": "00:00:41,856 --> 00:00:45,616",
    "chinese": "你真幸运！嗯，祝你度过愉快的一天！",
    "english": "Lucky you! Well, enjoy your day!"
  },
  {
    "timestamp": "00:00:45,936 --> 00:00:46,896",
    "chinese": "你也是！",
    "english": "You too!"
  },
  {
    "timestamp": "00:00:47,168 --> 00:00:50,080",
    "chinese": "不管晴天雨天，我总是很开心！",
    "english": "I’m always happy, rain or shine!"
  }
]