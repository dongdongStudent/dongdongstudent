      "sentences": [
        {
          "sentence_id": 1,
          "text": "I'm Peppa Pig.",
          "chinese": "我是佩奇。",
          "start_time": "00:00:02,560",
          "end_time": "00:00:04,450"
        },
        {
          "sentence_id": 2,
          "text": "This is my little brother, George.",
          "chinese": "这是我的弟弟乔治。",
          "start_time": "00:00:04,720",
          "end_time": "00:00:06,720"
        },
        {
          "sentence_id": 3,
          "text": "This is Mummy Pig.",
          "chinese": "这是猪妈妈。",
          "start_time": "00:00:07,440",
          "end_time": "00:00:09,530"
        },
        {
          "sentence_id": 4,
          "text": "And this is Daddy Pig.",
          "chinese": "这是猪爸爸。",
          "start_time": "00:00:09,810",
          "end_time": "00:00:12,420"
        },
        {
          "sentence_id": 5,
          "text": "Peppa pig.",
          "chinese": "佩奇。",
          "start_time": "00:00:13,550",
          "end_time": "00:00:14,640"
        },
        {
          "sentence_id": 6,
          "text": "Muddy Puddles.",
          "chinese": "泥坑。",
          "start_time": "00:00:20,860",
          "end_time": "00:00:22,880"
        },
        {
          "sentence_id": 7,
          "text": "It is raining today.",
          "chinese": "今天下雨了。",
          "start_time": "00:00:27,160",
          "end_time": "00:00:28,810"
        },
        {
          "sentence_id": 8,
          "text": "So, Peppa and George Cannot play outside.",
          "chinese": "所以佩奇和乔治不能在外面玩。",
          "start_time": "00:00:28,810",
          "end_time": "00:00:31,880"
        },
        {
          "sentence_id": 9,
          "text": "Daddy, it's stopped raining.",
          "chinese": "爸爸，雨停了。",
          "start_time": "00:00:34,150",
          "end_time": "00:00:36,270"
        },
        {
          "sentence_id": 10,
          "text": "Can we go out to play?",
          "chinese": "我们可以出去玩吗？",
          "start_time": "00:00:36,270",
          "end_time": "00:00:38,120"
        },
        {
          "sentence_id": 11,
          "text": "Alright, run along you two.",
          "chinese": "好了，你们两个去玩吧。",
          "start_time": "00:00:39,060",
          "end_time": "00:00:41,610"
        },
        {
          "sentence_id": 12,
          "text": "Peppa loves jumping in muddy puddles.",
          "chinese": "佩奇喜欢在泥坑里跳。",
          "start_time": "00:00:51,470",
          "end_time": "00:00:54,590"
        },
        {
          "sentence_id": 13,
          "text": "I love muddy puddles.",
          "chinese": "我喜欢泥坑。",
          "start_time": "00:00:54,590",
          "end_time": "00:00:56,550"
        },
        {
          "sentence_id": 14,
          "text": "Peppa. If you jump in muddy puddles,",
          "chinese": "佩奇，如果你要在泥坑里跳，",
          "start_time": "00:01:00,790",
          "end_time": "00:01:03,870"
        },
        {
          "sentence_id": 15,
          "text": "you must wear your boots.",
          "chinese": "你必须穿上你的靴子。",
          "start_time": "00:01:03,870",
          "end_time": "00:01:05,430"
        },
        {
          "sentence_id": 16,
          "text": "Sorry, Mummy.",
          "chinese": "对不起，妈妈。",
          "start_time": "00:01:06,300",
          "end_time": "00:01:07,250"
        },
        {
          "sentence_id": 17,
          "text": "George likes to jump in muddy puddles, too.",
          "chinese": "乔治也喜欢在泥坑里跳。",
          "start_time": "00:01:17,450",
          "end_time": "00:01:20,300"
        },
        {
          "sentence_id": 18,
          "text": "George. If you jump in muddy puddles,",
          "chinese": "乔治，如果你要在泥坑里跳，",
          "start_time": "00:01:22,170",
          "end_time": "00:01:25,460"
        },
        {
          "sentence_id": 19,
          "text": "you must wear your boots.",
          "chinese": "你必须穿上你的靴子。",
          "start_time": "00:01:25,460",
          "end_time": "00:01:27,080"
        },
        {
          "sentence_id": 20,
          "text": "Peppa likes to look after her little brother, George.",
          "chinese": "佩奇喜欢照顾她的弟弟乔治。",
          "start_time": "00:01:30,630",
          "end_time": "00:01:33,090"
        },
        {
          "sentence_id": 21,
          "text": "George, let's find some more puddles.",
          "chinese": "乔治，我们再找些泥坑吧。",
          "start_time": "00:01:41,590",
          "end_time": "00:01:44,580"
        },
        {
          "sentence_id": 22,
          "text": "Peppa and George are having a lot of fun.",
          "chinese": "佩奇和乔治玩得很开心。",
          "start_time": "00:01:51,530",
          "end_time": "00:01:54,320"
        },
        {
          "sentence_id": 23,
          "text": "Peppa has found a little puddle.",
          "chinese": "佩奇找到了一个小泥坑。",
          "start_time": "00:01:54,800",
          "end_time": "00:01:56,900"
        },
        {
          "sentence_id": 24,
          "text": "George has found a big puddle.",
          "chinese": "乔治找到了一个大泥坑。",
          "start_time": "00:01:57,880",
          "end_time": "00:01:59,700"
        },
        {
          "sentence_id": 25,
          "text": "Look, George. There's a really big puddle.",
          "chinese": "看，乔治。那里有一个非常大的泥坑。",
          "start_time": "00:02:10,510",
          "end_time": "00:02:14,460"
        },
        {
          "sentence_id": 26,
          "text": "George wants to jump into the big puddle first.",
          "chinese": "乔治想先跳进大泥坑。",
          "start_time": "00:02:17,930",
          "end_time": "00:02:20,410"
        },
        {
          "sentence_id": 27,
          "text": "Stop, George.",
          "chinese": "停下，乔治。",
          "start_time": "00:02:21,330",
          "end_time": "00:02:22,840"
        },
        {
          "sentence_id": 28,
          "text": "I must check if it's safe for you.",
          "chinese": "我必须检查一下对你是否安全。",
          "start_time": "00:02:23,390",
          "end_time": "00:02:25,270"
        },
        {
          "sentence_id": 29,
          "text": "Good. It is safe for you.",
          "chinese": "好的。对你来说是安全的。",
          "start_time": "00:02:28,560",
          "end_time": "00:02:30,610"
        },
        {
          "sentence_id": 30,
          "text": "Sorry, George. It's only mud.",
          "chinese": "对不起，乔治。只是泥而已。",
          "start_time": "00:02:35,540",
          "end_time": "00:02:38,220"
        },
        {
          "sentence_id": 31,
          "text": "Peppa and George love jumping in muddy puddles.",
          "chinese": "佩奇和乔治喜欢在泥坑里跳。",
          "start_time": "00:02:48,740",
          "end_time": "00:02:51,690"
        },
        {
          "sentence_id": 32,
          "text": "Come on, George. Let's go and show Daddy.",
          "chinese": "来吧，乔治。我们去给爸爸看看。",
          "start_time": "00:02:58,120",
          "end_time": "00:03:01,490"
        },
        {
          "sentence_id": 33,
          "text": "Goodness me.",
          "chinese": "天哪。",
          "start_time": "00:03:07,970",
          "end_time": "00:03:09,320"
        },
        {
          "sentence_id": 34,
          "text": "Daddy. Daddy. Guess what we've been doing.",
          "chinese": "爸爸。爸爸。猜猜我们刚才在做什么。",
          "start_time": "00:03:09,510",
          "end_time": "00:03:12,530"
        },
        {
          "sentence_id": 35,
          "text": "Let me think..",
          "chinese": "让我想想...",
          "start_time": "00:03:13,390",
          "end_time": "00:03:14,590"
        },
        {
          "sentence_id": 36,
          "text": "Have you been watching television?",
          "chinese": "你们一直在看电视吗？",
          "start_time": "00:03:15,380",
          "end_time": "00:03:16,650"
        },
        {
          "sentence_id": 37,
          "text": "No. No. Daddy.",
          "chinese": "不。不。爸爸。",
          "start_time": "00:03:17,510",
          "end_time": "00:03:18,850"
        },
        {
          "sentence_id": 38,
          "text": "Have you just had a bath?",
          "chinese": "你们刚洗了澡？",
          "start_time": "00:03:19,950",
          "end_time": "00:03:21,280"
        },
        {
          "sentence_id": 39,
          "text": "No. No.",
          "chinese": "不。不。",
          "start_time": "00:03:21,820",
          "end_time": "00:03:25,870"
        },
        {
          "sentence_id": 40,
          "text": "I know. You've been jumping in muddy puddles.",
          "chinese": "我知道了。你们一直在泥坑里跳。",
          "start_time": "00:03:26,180",
          "end_time": "00:03:30,090"
        },
        {
          "sentence_id": 41,
          "text": "Yes. Yes. Daddy. We've been jumping in muddy puddles.",
          "chinese": "是的。是的。爸爸。我们一直在泥坑里跳。",
          "start_time": "00:03:30,800",
          "end_time": "00:03:34,670"
        },
        {
          "sentence_id": 42,
          "text": "Ho. Ho. And look at the mess you're in.",
          "chinese": "呵呵。看看你们弄得这么脏。",
          "start_time": "00:03:35,270",
          "end_time": "00:03:37,880"
        },
        {
          "sentence_id": 43,
          "text": "Oooh..",
          "chinese": "哦...",
          "start_time": "00:03:38,800",
          "end_time": "00:03:39,690"
        },
        {
          "sentence_id": 44,
          "text": "Oh, well, it's only mud.",
          "chinese": "哦，好吧，只是泥而已。",
          "start_time": "00:03:40,460",
          "end_time": "00:03:42,580"
        },
        {
          "sentence_id": 45,
          "text": "Let's clean up quickly before Mummy sees the mess.",
          "chinese": "我们快在妈妈看到之前清理干净。",
          "start_time": "00:03:43,620",
          "end_time": "00:03:46,190"
        },
        {
          "sentence_id": 46,
          "text": "Daddy, when we've cleaned up,",
          "chinese": "爸爸，等我们清理干净，",
          "start_time": "00:03:48,720",
          "end_time": "00:03:50,980"
        },
        {
          "sentence_id": 47,
          "text": "will you and Mummy Come and play, too?",
          "chinese": "你和妈妈也来玩吗？",
          "start_time": "00:03:51,510",
          "end_time": "00:03:53,810"
        },
        {
          "sentence_id": 48,
          "text": "Yes, we can all play in the garden.",
          "chinese": "是的，我们都可以在花园里玩。",
          "start_time": "00:03:54,140",
          "end_time": "00:03:56,670"
        },
        {
          "sentence_id": 49,
          "text": "Peppa and George are wearing their boots.",
          "chinese": "佩奇和乔治穿着他们的靴子。",
          "start_time": "00:04:03,680",
          "end_time": "00:04:05,740"
        },
        {
          "sentence_id": 50,
          "text": "Mummy and Daddy are wearing their boots.",
          "chinese": "妈妈和爸爸穿着他们的靴子。",
          "start_time": "00:04:06,170",
          "end_time": "00:04:08,310"
        },
        {
          "sentence_id": 51,
          "text": "Peppa loves jumping up and down in muddy puddles.",
          "chinese": "佩奇喜欢在泥坑里跳上跳下。",
          "start_time": "00:04:09,280",
          "end_time": "00:04:12,270"
        },
        {
          "sentence_id": 52,
          "text": "Everyone loves jumping up and down in muddy puddles.",
          "chinese": "每个人都喜欢在泥坑里跳上跳下。",
          "start_time": "00:04:14,130",
          "end_time": "00:04:16,930"
        },
        {
          "sentence_id": 53,
          "text": "Oh, Daddy pig, look at the mess you're in.",
          "chinese": "哦，猪爸爸，看看你弄得这么脏。",
          "start_time": "00:04:25,900",
          "end_time": "00:04:29,050"
        },
        {
          "sentence_id": 54,
          "text": "It's only mud.",
          "chinese": "只是泥而已。",
          "start_time": "00:04:29,630",
          "end_time": "00:04:31,310"
        }
      ]
    },
