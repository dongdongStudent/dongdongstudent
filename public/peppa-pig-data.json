        {
          "sentence_id": 88,
          "text": "I win, Daddy.",
          "chinese": "我赢了，爸爸。",
          "start_time": "00:01:51,811",
          "end_time": "00:01:53,301"
        },
        {
          "sentence_id": 89,
          "text": "Oh, well done, Peppa.",
          "chinese": "哦，做得好，佩奇。",
          "start_time": "00:01:53,813",
          "end_time": "00:01:56,111"
        },
        {
          "sentence_id": 90,
          "text": "Whaaaaaaaaaaa.",
          "chinese": "哇...",
          "start_time": "00:01:57,317",
          "end_time": "00:01:58,079"
        },
        {
          "sentence_id": 91,
          "text": "George?",
          "chinese": "乔治？",
          "start_time": "00:01:58,184",
          "end_time": "00:01:59,674"
        },
        {
          "sentence_id": 92,
          "text": "Whaaaaaaaaa.",
          "chinese": "哇...",
          "start_time": "00:02:00,019",
          "end_time": "00:02:01,680"
        },
        {
          "sentence_id": 93,
          "text": "George, what's the matter?",
          "chinese": "乔治，怎么了？",
          "start_time": "00:02:01,821",
          "end_time": "00:02:03,516"
        },
        {
          "sentence_id": 94,
          "text": "Dinosaur..",
          "chinese": "恐龙...",
          "start_time": "00:02:03,690",
          "end_time": "00:02:05,817"
        },
        {
          "sentence_id": 95,
          "text": "George, have you lost Mr. Dinosaur?",
          "chinese": "乔治，你把恐龙先生弄丢了吗？",
          "start_time": "00:02:06,192",
          "end_time": "00:02:09,389"
        },
        {
          "sentence_id": 96,
          "text": "George has lost Mr. Dinosaur.",
          "chinese": "乔治把恐龙先生弄丢了。",
          "start_time": "00:02:11,197",
          "end_time": "00:02:13,597"
        },
        {
          "sentence_id": 97,
          "text": "Don't worry George.",
          "chinese": "别担心，乔治。",
          "start_time": "00:02:13,700",
          "end_time": "00:02:14,758"
        },
        {
          "sentence_id": 98,
          "text": "We'll find Mr. Dinosaur.",
          "chinese": "我们会找到恐龙先生的。",
          "start_time": "00:02:14,968",
          "end_time": "00:02:16,458"
        },
        {
          "sentence_id": 99,
          "text": "It's a job for a detective.",
          "chinese": "这是侦探的工作。",
          "start_time": "00:02:17,203",
          "end_time": "00:02:18,898"
        },
        {
          "sentence_id": 100,
          "text": "Daddy, what is a detective?",
          "chinese": "爸爸，什么是侦探？",
          "start_time": "00:02:19,639",
          "end_time": "00:02:22,608"
        },
        {
          "sentence_id": 101,
          "text": "A detective is a very important person",
          "chinese": "侦探是一个非常厉害的人",
          "start_time": "00:02:23,276",
          "end_time": "00:02:26,473"
        },
        {
          "sentence_id": 102,
          "text": "who is good at finding things.",
          "chinese": "他擅长找东西。",
          "start_time": "00:02:26,646",
          "end_time": "00:02:28,045"
        },
        {
          "sentence_id": 103,
          "text": "Me. Me. I'm good at finding things.",
          "chinese": "我。我。我擅长找东西。",
          "start_time": "00:02:28,648",
          "end_time": "00:02:31,617"
        },
        {
          "sentence_id": 104,
          "text": "Alright. Peppa is the detective.",
          "chinese": "好吧。佩奇是侦探。",
          "start_time": "00:02:32,151",
          "end_time": "00:02:34,483"
        },
        {
          "sentence_id": 105,
          "text": "George. I am the detective.",
          "chinese": "乔治。我是侦探。",
          "start_time": "00:02:35,488",
          "end_time": "00:02:38,355"
        },
        {
          "sentence_id": 106,
          "text": "I will help you find Mr. Dinosaur.",
          "chinese": "我会帮你找到恐龙先生。",
          "start_time": "00:02:38,992",
          "end_time": "00:02:41,654"
        },
        {
          "sentence_id": 107,
          "text": "Maybe the detective should ask",
          "chinese": "也许侦探应该问",
          "start_time": "00:02:43,863",
          "end_time": "00:02:44,989"
        },
        {
          "sentence_id": 108,
          "text": "George some simple questions.",
          "chinese": "乔治一些简单的问题。",
          "start_time": "00:02:45,131",
          "end_time": "00:02:47,224"
        },
        {
          "sentence_id": 109,
          "text": "George? Where's Mr. Dinosaur?",
          "chinese": "乔治？恐龙先生在哪里？",
          "start_time": "00:02:47,867",
          "end_time": "00:02:51,234"
        },
        {
          "sentence_id": 110,
          "text": "Whaaaaaaaaaa.",
          "chinese": "哇...",
          "start_time": "00:02:52,739",
          "end_time": "00:02:54,001"
        },
        {
          "sentence_id": 111,
          "text": "George does not know where Mr. Dinosaur is.",
          "chinese": "乔治不知道恐龙先生在哪里。",
          "start_time": "00:02:54,240",
          "end_time": "00:02:56,640"
        },
        {
          "sentence_id": 112,
          "text": "The detective could try and guess",
          "chinese": "侦探可以试着猜",
          "start_time": "00:02:56,743",
          "end_time": "00:02:58,005"
        },
        {
          "sentence_id": 113,
          "text": "where Mr. Dinosaur might be.",
          "chinese": "恐龙先生可能在哪里。",
          "start_time": "00:02:58,144",
          "end_time": "00:03:00,510"
        },
        {
          "sentence_id": 114,
          "text": "I know. I know where he is.",
          "chinese": "我知道。我知道他在哪里。",
          "start_time": "00:03:00,880",
          "end_time": "00:03:03,440"
        },
        {
          "sentence_id": 115,
          "text": "George always has Mr. Dinosaur with him in the bath.",
          "chinese": "乔治洗澡的时候总是带着恐龙先生。",
          "start_time": "00:03:07,520",
          "end_time": "00:03:10,887"
        },
        {
          "sentence_id": 116,
          "text": "So Mr. Dinosaur is in the bath.",
          "chinese": "所以恐龙先生在浴缸里。",
          "start_time": "00:03:11,524",
          "end_time": "00:03:14,015"
        },
        {
          "sentence_id": 117,
          "text": "Mr. Dinosaur is not in the bath.",
          "chinese": "恐龙先生不在浴缸里。",
          "start_time": "00:03:14,961",
          "end_time": "00:03:16,656"
        },
        {
          "sentence_id": 118,
          "text": "Oh. I know.",
          "chinese": "哦。我知道。",
          "start_time": "00:03:16,763",
          "end_time": "00:03:18,754"
        },
        {
          "sentence_id": 119,
          "text": "I know where Mr. Dinosaur is.",
          "chinese": "我知道恐龙先生在哪里了。",
          "start_time": "00:03:18,965",
          "end_time": "00:03:20,956"
        },
        {
          "sentence_id": 120,
          "text": "George always has Mr. Dinosaur in his bed at night.",
          "chinese": "乔治晚上总是把恐龙先生放在床上。",
          "start_time": "00:03:22,669",
          "end_time": "00:03:26,469"
        },
        {
          "sentence_id": 121,
          "text": "So that's where he is.",
          "chinese": "所以他就在那里。",
          "start_time": "00:03:27,473",
          "end_time": "00:03:29,338"
        },
        {
          "sentence_id": 122,
          "text": "Mr. Dinosaur is not in George's bed.",
          "chinese": "恐龙先生不在乔治的床上。",
          "start_time": "00:03:30,276",
          "end_time": "00:03:32,210"
        },
        {
          "sentence_id": 123,
          "text": "Oh.",
          "chinese": "哦。",
          "start_time": "00:03:32,412",
          "end_time": "00:03:33,037"
        },
        {
          "sentence_id": 124,
          "text": "Maybe we should try the garden.",
          "chinese": "也许我们应该去花园看看。",
          "start_time": "00:03:33,780",
          "end_time": "00:03:35,907"
        },
        {
          "sentence_id": 125,
          "text": "Yes, the garden.",
          "chinese": "是的，花园。",
          "start_time": "00:03:36,349",
          "end_time": "00:03:37,907"
        },
        {
          "sentence_id": 126,
          "text": "I was going to say that.",
          "chinese": "我刚想这么说。",
          "start_time": "00:03:38,551",
          "end_time": "00:03:40,280"
        },
        {
          "sentence_id": 127,
          "text": "Where is Mr. Dinosaur?",
          "chinese": "恐龙先生在哪里？",
          "start_time": "00:03:45,058",
          "end_time": "00:03:47,288"
        },
        {
          "sentence_id": 128,
          "text": "Mr. Dinosaur is very hard to find.",
          "chinese": "恐龙先生很难找。",
          "start_time": "00:03:48,294",
          "end_time": "00:03:50,057"
        },
        {
          "sentence_id": 129,
          "text": "Oh. Mr. Dinosaur isn't anywhere.",
          "chinese": "哦。恐龙先生哪儿都没有。",
          "start_time": "00:03:50,563",
          "end_time": "00:03:54,556"
        },
        {
          "sentence_id": 130,
          "text": "George? You do love to throw Mr. Dinosaur in the air..",
          "chinese": "乔治？你很喜欢把恐龙先生抛到空中...",
          "start_time": "00:03:55,702",
          "end_time": "00:03:59,695"
        },
        {
          "sentence_id": 131,
          "text": "I wonder if this time",
          "chinese": "我想这次是不是",
          "start_time": "00:04:01,441",
          "end_time": "00:04:02,430"
        },
        {
          "sentence_id": 132,
          "text": "you threw Mr. Dinosaur just a bit too high.",
          "chinese": "你把恐龙先生抛得太高了。",
          "start_time": "00:04:02,575",
          "end_time": "00:04:04,805"
        },
        {
          "sentence_id": 133,
          "text": "There he is. There he is.",
          "chinese": "他在那里。他在那里。",
          "start_time": "00:04:06,813",
          "end_time": "00:04:08,440"
        },
        {
          "sentence_id": 134,
          "text": "I saw him first.",
          "chinese": "我先看到的。",
          "start_time": "00:04:08,581",
          "end_time": "00:04:10,014"
        },
        {
          "sentence_id": 135,
          "text": "Well done, Peppa.",
          "chinese": "做得好，佩奇。",
          "start_time": "00:04:11,317",
          "end_time": "00:04:13,251"
        },
        {
          "sentence_id": 136,
          "text": "You really are a very good detective.",
          "chinese": "你真的是个很好的侦探。",
          "start_time": "00:04:13,820",
          "end_time": "00:04:15,720"
        },
        {
          "sentence_id": 137,
          "text": "Dinosaur.",
          "chinese": "恐龙。",
          "start_time": "00:04:18,157",
          "end_time": "00:04:22,821"
        },
        {
          "sentence_id": 138,
          "text": "Grrrrrrrrrr.",
          "chinese": "嗷呜...",
          "start_time": "00:04:23,329",
          "end_time": "00:04:24,455"
        },
        {
          "sentence_id": 139,
          "text": "George is so happy to have Mr. Dinosaur back again.",
          "chinese": "乔治很高兴又找回了恐龙先生。",
          "start_time": "00:04:25,598",
          "end_time": "00:04:28,465"
        },
        {
          "sentence_id": 140,
          "text": "Wheeeeeeeeee.",
          "chinese": "咻...",
          "start_time": "00:04:28,534",
          "end_time": "00:04:29,728"
        },
        {
          "sentence_id": 141,
          "text": "Maybe it isn't a good idea",
          "chinese": "也许在树附近",
          "start_time": "00:04:32,472",
          "end_time": "00:04:33,962"
        },
        {
          "sentence_id": 142,
          "text": "to play with dinosaurs near trees.",
          "chinese": "玩恐龙不是个好主意。",
          "start_time": "00:04:34,040",
          "end_time": "00:04:36,474"
        },
        {
          "sentence_id": 143,
          "text": "Dinosaur.",
          "chinese": "恐龙。",
          "start_time": "00:04:42,181",
          "end_time": "00:04:43,478"
        }
      ]
    }
  ]
}