      "wordCount": 11
    },
    {
      "id": 3,
      "startTime": 7.712,
      "endTime": 12.128,
      "text": "Me too. Emma, these are my parents.",
      "words": ["Me", "too", "Emma", "these", "are", "my", "parents"],
      "translation": "我也是。Emma，这是我的父母。",
      "wordCount": 7
    },
    {
      "id": 4,
      "startTime": 12.752,
      "endTime": 16.224,
      "text": "Dad and Mum, this is my classmate, Emma.",
      "words": ["Dad", "and", "Mum", "this", "is", "my", "classmate", "Emma"],
      "translation": "爸爸、妈妈，这是我的同学 Emma。",
