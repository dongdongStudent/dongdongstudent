    {
      "id": 2,
      "startTime": 2,
      "endTime": 7.232,
      "text": "Oh, hi, Yaming! Glad to see you here in the park!",
      "words": ["Oh", "hi", "Yaming", "Glad", "to", "see", "you", "here", "in", "the", "park"],
